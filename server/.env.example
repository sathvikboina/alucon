PORT=
MONGO_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:3000

# First head admin created at boot. Required in production; local development
# falls back to the shared demo password when these are blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Transactional email (Brevo). Announcement email is skipped when this is blank.
BREVO_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI features (Gemini). Optional: without a key the app uses offline,
# extractive output so the UI still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Local sentence embeddings for AI Search. BGE-small-en-v1.5 is 384-dim and runs
# on CPU through @huggingface/transformers.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

ENCRYPTION_KEY=

SUPPRESS_NO_CONFIG_WARNING=
