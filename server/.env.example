PORT=
# Authenticated MongoDB connection, e.g.
# mongodb://alumniApp:<password>@127.0.0.1:27017/alumniconnect?authSource=alumniconnect
MONGO_URI=
# Credentials for a test-only database user (npm test). Optional; tests fall
# back to MONGO_URI or an unauthenticated local MongoDB.
TEST_MONGO_URI=
# Only needed when run.sh has to create a fresh MongoDB container; these seed
# the root user that the container starts with under --auth.
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
JWT_SECRET=
# On Vercel set this to the deployed client origin, e.g.
# https://alucon.vercel.app
CLIENT_URL=http://localhost:3000
# Number of reverse-proxy hops. Set 1 behind Vercel or nginx.
TRUST_PROXY=

# First head admin created at boot. Required in production; local development
# falls back to the shared demo password when these are blank.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Transactional email (Brevo). Announcement email is skipped when this is blank.
BREVO_API_KEY=

CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI features (Gemini). Optional: without a key the app uses offline,
# extractive output so the UI still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Local sentence embeddings for AI Search. BGE-small-en-v1.5 is 384-dim and runs
# on CPU through @huggingface/transformers.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

ENCRYPTION_KEY=

SUPPRESS_NO_CONFIG_WARNING=
